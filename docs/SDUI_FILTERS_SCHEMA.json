{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ServerDrivenFiltersConfig",
  "type": "object",
  "required": [
    "schemaVersion",
    "configVersion",
    "issuedAt",
    "expiresAt",
    "keyId",
    "minAppVersion",
    "screenId",
    "filters"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "configVersion": {
      "type": "integer",
      "minimum": 1
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "keyId": {
      "type": "string",
      "minLength": 1
    },
    "minAppVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "screenId": {
      "type": "string",
      "enum": ["custody_screen", "dashboard_screen"]
    },
    "defaultFilterId": {
      "type": "string"
    },
    "filters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "enabled", "order", "statuses"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string" },
          "enabled": { "type": "boolean" },
          "order": { "type": "integer" },
          "icon": { "type": "string" },
          "colorHex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "statuses": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
